# Copia questo file in .env.local e adatta i valori.

# Database PostgreSQL.
# In locale: `npm run dev` avvia un PostgreSQL embedded (pacchetto embedded-postgres) su questa porta.
# In produzione: stringa di connessione Supabase (regione UE, pooler in modalità transaction).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Segreto usato per firmare i codici OTP (almeno 32 caratteri casuali).
OTP_PEPPER=cambia-questo-valore-con-una-stringa-casuale-lunga

# URL pubblico dell'app (link nelle email).
APP_URL=http://localhost:3000

# Invio SMS ed email. "console" = stampati nel terminale (sviluppo, codici OTP anche a schermo).
# "brevo" = invio vero con Brevo (guida in DEPLOY.md, "SMS ed email con Brevo").
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Con EMAIL_PROVIDER=resend: chiave API di Resend.
RESEND_API_KEY=
# Con "brevo": chiave API (segreta, solo lato server) e mittente degli SMS (massimo 11 lettere o cifre).
BREVO_API_KEY=
SMS_SENDER=geco
# Mittente delle email: indirizzo di un dominio verificato sul provider.
EMAIL_FROM=info@gecoitalia.it

# Sito di prova visibile solo al team (istruzioni in DEPLOY.md): accessi "nome:password" separati da
# virgola, per esempio tommaso:password1,cliente:password2. Vuota = sito aperto a tutti.
SITE_ACCESS=
# Con il sito protetto da SITE_ACCESS, DEMO_MODE=1 mostra a schermo i codici SMS e l'account di prova
# e permette di comprare token senza pagare. Senza SITE_ACCESS resta spento in ogni caso.
DEMO_MODE=

# Accesso con Google (console.cloud.google.com → Credenziali → ID client OAuth "Applicazione web").
# URI di reindirizzamento autorizzato: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Accesso con Apple (developer.apple.com → Identifiers → Services ID con "Sign in with Apple").
# Return URL: <APP_URL>/auth/apple/callback (Apple vuole HTTPS e un dominio vero, non localhost).
# APPLE_PRIVATE_KEY è il contenuto del file .p8, su una riga con \n al posto degli a capo.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Storage dei file caricati (foto profilo, logo, portfolio).
# "local" = disco in public/uploads (solo sviluppo). "supabase" = Supabase Storage (produzione:
# su Vercel il disco è di sola lettura). In produzione va impostato a "supabase".
STORAGE_PROVIDER=local
# Necessari solo con STORAGE_PROVIDER=supabase. La service_role key è segreta: solo lato server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Pagamenti Stripe (istruzioni in DEPLOY.md, "Pagamenti con Stripe"). Vuote = pagamenti spenti:
# l'Area Partner mostra "non ancora attivi" (o l'acquisto simulato con DEMO_MODE=1).
# In locale e sul sito di prova usare le chiavi di TEST (sk_test_...), mai quelle live.
STRIPE_SECRET_KEY=
# Segreto di firma del webhook <APP_URL>/api/stripe/webhook (whsec_...). In locale lo stampa
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Aliquota IVA 22% creata da `npm run stripe:setup` (txr_...).
STRIPE_TAX_RATE_ID=

# Cloudflare Turnstile (antispam su richiesta di contatto, registrazione e recupero password).
# Vuote = controllo spento (sviluppo e test). Chiavi di prova Cloudflare che passano sempre:
# 1x00000000000000000000AA (sito) e 1x0000000000000000000000000000000AA (segreta).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gestionale su un indirizzo proprio, es. https://admin.gecoitalia.it (DEPLOY.md, passo 4b): dal sito /admin
# sparisce. Vuota = gestionale su <APP_URL>/admin. In locale, per provarlo separato, servono due nomi:
# APP_URL=http://sito.localhost:3000 e ADMIN_URL=http://admin.localhost:3000.
ADMIN_URL=
# Gestionale (/admin) e assistenza (istruzioni in ATTIVAZIONE-SERVIZI.md, sezione 4).
# Email degli amministratori, separate da virgola: entrano nel gestionale dopo aver confermato l'email.
ADMIN_EMAILS=
# Indirizzo dell'assistenza mostrato sul sito e "rispondi a" delle email del team.
SUPPORT_EMAIL=assistenza@gecoitalia.it
# Facoltativa: casella che riceve un avviso a ogni nuova richiesta o risposta (diversa da SUPPORT_EMAIL).
SUPPORT_ALERT_EMAIL=
# Email in arrivo nel gestionale: segreto del webhook Resend "email.received" (whsec_...)...
RESEND_INBOUND_SECRET=
# ...oppure, con Postmark o un altro inoltro, token segreto da mettere nell'URL del webhook (?token=...).
INBOUND_EMAIL_TOKEN=

# Facoltativa. Cron giornaliero di Vercel (vercel.json) che accredita i crediti mensili degli abbonamenti annuali:
# funziona anche senza (non dà mai crediti in più); impostata, solo Vercel può chiamarlo.
CRON_SECRET=

# Data di lancio del sito (AAAA-MM-GG): la promo del logo in Home (39 € / 99 € + IVA) vale 6 mesi da qui.
# Finché è vuota la promo resta attiva.
LANCIO_SITO=
