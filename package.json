{
  "name": "geco-piattaforma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "concurrently -k -n db,web -c green,blue \"npm:db:server\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "db:server": "tsx scripts/db-server.ts",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env.local scripts/stripe-setup.ts",
    "test:stripe": "node --env-file=.env.vercel ./node_modules/.bin/vitest run src/lib/billing/stripe.sandbox.test.ts",
    "pentest:server": "tsx scripts/pentest-server.ts",
    "pentest:scan": "docker compose -f pentest/compose.yaml run --rm kali scansione",
    "pentest:shell": "docker compose -f pentest/compose.yaml run --rm kali",
    "pentest:zap": "docker compose -f pentest/compose.yaml run --rm zap",
    "pentest:update": "docker compose -f pentest/compose.yaml build --pull kali && docker compose -f pentest/compose.yaml --profile zap pull zap"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.5",
    "@fontsource/fraunces": "^5.2.5",
    "@sentry/nextjs": "^11.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "^9.0.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
