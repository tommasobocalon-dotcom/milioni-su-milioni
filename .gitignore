# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/.next-pentest/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database locale (embedded-postgres) e strumenti
/.data/
/.taste-skill/
/.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/
# risultati delle scansioni di sicurezza (pentest/README.md)
/pentest/risultati/

# eccezione: l'esempio di configurazione va versionato
!.env.example
/public/uploads

# fotogrammi di controllo di design/geco/anima.mjs --prove
/design/geco/prove/

# worker di MapLibre copiato da scripts/copy-maplibre-worker.mjs (prebuild/predev)
/public/maplibre-gl-worker.mjs
